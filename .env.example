# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Restart `npm run dev` after every change.

# --- Required: Google Sheets service account (the app reads your workbook with it) ---
# The id is the long part of the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# "client_email" from the service-account JSON key
GOOGLE_CLIENT_EMAIL=
# "private_key" from the JSON key: one line, in double quotes, keep the \n characters
GOOGLE_PRIVATE_KEY=

# --- Required: two random strings (create each with: openssl rand -base64 32) ---
# Signs the session cookie
AUTH_SECRET=
# Mixed into the demo-mode random number. Do not change it casually: every seed gives a new factor
DEMO_SALT=

# --- Optional: Google sign-in (README, Setup step 8) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Optional: only when the app runs behind a proxy or on a host such as Vercel ---
# AUTH_TRUST_HOST=true
